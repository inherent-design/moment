{
  "name": "@inherent.design/moment",
  "version": "0.2.0-preview.1",
  "description": "Local contextual memory, evidence and governed coordination for agents",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "check": "pnpm check:quick && pnpm test",
    "check:types": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "node scripts/test.mjs",
    "moment": "node runtime/cli.mjs",
    "test:codex-protocol": "node scripts/test.mjs --script scripts/codex-isolated-probe.mjs",
    "test:codex-native": "node scripts/test.mjs --script scripts/codex-native-check.mjs",
    "generate:bindings": "node scripts/generate-bindings.mjs",
    "check:bindings": "node scripts/generate-bindings.mjs --check",
    "test:integration": "node scripts/test.mjs verification/integration.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "pack:release": "pnpm pack --skip-manifest-obfuscation --pack-destination dist",
    "build:core": "node scripts/build-core.mjs build",
    "check:core": "node scripts/build-core.mjs check",
    "test:proof": "node scripts/build-core.mjs prove",
    "setup:formal": "node scripts/setup-formal.mjs",
    "check:unused": "knip --no-progress",
    "check:quick": "pnpm check:types && pnpm check:core && pnpm check:bindings && pnpm check:docs && pnpm check:unused",
    "test:codex-mcp:protocol": "node scripts/test.mjs --script scripts/codex-mcp-native-check.mjs --protocol-only",
    "test:codex-mcp": "node scripts/test.mjs --script scripts/codex-mcp-native-check.mjs",
    "check:renovate": "pnpm --ignore-scripts dlx --package renovate@44.256.1 renovate-config-validator --strict renovate.json",
    "security:scan": "node scripts/check-security.mjs",
    "check:ci": "actionlint -shellcheck=",
    "check:release": "node scripts/publish-package.mjs --check",
    "test:store-readback": "node verification/store-readback.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "knip": "6.46.1",
    "typescript": "7.0.2",
    "typescript-schema": "npm:typescript@6.0.2"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "8.20.0"
  },
  "packageManager": "pnpm@12.18.0",
  "author": "inherent.design",
  "homepage": "https://github.com/inherent-design/moment#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inherent-design/moment.git"
  },
  "bugs": {
    "url": "https://github.com/inherent-design/moment/issues"
  },
  "bin": {
    "moment": "runtime/cli.mjs"
  },
  "exports": {
    "./client": {
      "types": "./runtime/client.d.mts",
      "import": "./runtime/client.mjs"
    },
    "./contracts": {
      "types": "./contracts/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "files": [
    "runtime/",
    "contracts/",
    "docs/",
    "scripts/generate-bindings.mjs",
    "scripts/schema-compiler.mjs",
    "mise.toml",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "AGENTS.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "core/",
    "proof/",
    "toolchain.json",
    "scripts/core-tools.mjs",
    "scripts/build-core.mjs",
    "scripts/core-correspondence.mjs",
    "scripts/setup-formal.mjs",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "scripts/formal-install.mjs"
  ]
}