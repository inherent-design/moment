{
  "name": "moment-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Local coordination runtime and boundary contracts",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "check": "tsc --noEmit && node scripts/check-docs.mjs && pnpm test",
    "check:types": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "node --test test/*.test.mjs",
    "moment": "node runtime/cli.mjs",
    "test:codex-protocol": "node scripts/codex-isolated-probe.mjs",
    "test:codex-native": "node scripts/codex-native-check.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "packageManager": "pnpm@12.18.0"
}
